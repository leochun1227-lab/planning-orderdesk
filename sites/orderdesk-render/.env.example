# Copy to .env for local runs:  node --env-file=.env server/index.mjs
FIREBASE_DATABASE_URL=https://planningorderdesk-default-rtdb.asia-southeast1.firebasedatabase.app
FIREBASE_ROOT=orderdesk/v2
# One of:
FIREBASE_SERVICE_ACCOUNT=
# FIREBASE_DATABASE_SECRET=
# Local test database instead of Firebase:
# FIREBASE_DATABASE_URL=memory://
# LOCAL_DB_FILE=.local-db.json
APP_PASSWORD=
SESSION_SECRET=
MAIL_SYNC_MODE=planning-pc
PLANNING_AGENT_TOKEN=
PLANNING_AGENT_ENABLED=false
# Only for scripts/migrate-legacy.mjs:
# ORDERDESK_KEY=
# Production line page (产线), read-only sources:
LONGTREE_APP_ID=
LONGTREE_APP_SECRET=
